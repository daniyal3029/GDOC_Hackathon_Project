{
  "name": "founder-brain-backend",
  "version": "1.0.0",
  "description": "Founder Brain - Meeting Intelligence Platform Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:rebuild": "docker-compose up -d --build",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v",
    "export:postman": "ts-node scripts/export-postman.ts",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration --runInBand",
    "test:e2e": "jest tests/e2e --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=html",
    "test:ci": "jest --coverage --ci --reporters=jest-junit --reporters=default"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@lancedb/lancedb": "^0.27.2",
    "@slack/webhook": "^7.0.9",
    "@socket.io/admin-ui": "^0.5.1",
    "@types/express-rate-limit": "^5.1.3",
    "@xenova/transformers": "^2.17.2",
    "apache-arrow": "^18.1.0",
    "axios": "^1.15.2",
    "bullmq": "^5.76.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.4.1",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.1",
    "mongoose": "^8.3.2",
    "openai": "^6.34.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "response-time": "^2.3.4",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
